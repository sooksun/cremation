// prisma/schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  ADMIN
  SCHOOL_ADMIN
  FINANCE
  ACCOUNTING
  GROUP_LEADER
  VIEWER
  MEMBER
}

enum AuditAction {
  CONTRIBUTION_PAYMENT
  BATCH_PAYMENT
  DEATH_CLAIM_CREATE
  DEATH_CLAIM_PAYMENT
  DEATH_CLAIM_APPROVE
  RECEIPT_CREATE
  PAYMENT_VOUCHER_CREATE
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum MemberStatus {
  ACTIVE
  RESIGNED
  DECEASED
  ARREARS
  SUSPENDED
}

enum DeathClaimType {
  MEMBER_DEATH
  PROTECTED_DEATH
}

enum DeceasedType {
  MEMBER
  PARENT
  CHILD
  SPOUSE
}

enum DeathClaimStatus {
  REPORTED
  COLLECTING
  FUND_COMPLETE
  READY_TO_PAY
  PAID
}

enum DeathCollectionChannel {
  SALARY_DEDUCTION
  BANK_TRANSFER
}

enum MembershipClass {
  ORDINARY
  CONTRIBUTORY
}

enum ProtectedRelationship {
  SPOUSE
  PARENT
  CHILD
}

enum MembershipEndReason {
  DECEASED
  RETIRED
  RESIGNED
  ARREARS_TERMINATED
  MANUAL
}

enum ReceiptType {
  MEMBER_CONTRIBUTION
  MEMBERSHIP_FEE
  BOOK_FEE
  ANNUAL_FEE
  ADVANCE_WELFARE
  OTHER
}

enum PaymentType {
  DEATH_BENEFIT
  OPERATING_EXPENSE
  BANK_FEE
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  passwordHash       String
  role               Role
  fullName           String
  signature          String?    @db.Text // ลายเซ็นอิเล็กทรอนิกส์ (base64 image)
  mustChangePassword Boolean    @default(false)
  school             School?    @relation(fields: [schoolId], references: [id])
  schoolId           String?
  group              Group?     @relation(fields: [groupId], references: [id])
  groupId            String?
  member             Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId           String?    @unique
  auditLogs          AuditLog[]
  approvedDeathClaims DeathClaim[] @relation("DeathClaimApprover")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  schoolId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// กลุ่มโรงเรียน (ระดับบน) — โรงเรียนอยู่ในกลุ่ม, สมาชิกอยู่ในโรงเรียน
model SchoolCluster {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  schools   School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  district            String?
  province            String?
  isActive            Boolean             @default(true)
  cluster             SchoolCluster?      @relation(fields: [clusterId], references: [id])
  clusterId           String?
  members             Member[]
  associationMembers  AssociationMember[]
  groups              Group[]
  users               User[]
  contributions       MemberContribution[]
  deathClaims         DeathClaim[]
  receipts            Receipt[]
  payments            PaymentVoucher[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model MemberType {
  id                  String             @id @default(cuid())
  code                String             @unique
  name                String
  description         String?
  active              Boolean            @default(true)
  associationMembers  AssociationMember[]
}

model Group {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  code      String
  name      String
  leader    Member?  @relation("GroupLeader", fields: [leaderId], references: [id])
  leaderId  String?
  members   Member[]
  users     User[]
}

// สมาชิกสมาคมผู้ประกอบวิชาชีพ (ต้นทางของข้อมูลบุคคล) — บางคนเป็นสมาชิกฌาปนกิจ บางคนไม่เป็น
model AssociationMember {
  id                   String    @id @default(cuid())
  school               School    @relation(fields: [schoolId], references: [id])
  schoolId             String
  memberType           MemberType @relation(fields: [memberTypeId], references: [id])
  memberTypeId         String
  associationMemberNo String?   // เลขสมาชิกสมาคม
  firstName            String
  lastName             String
  idCardNo             String?
  birthDate            DateTime?
  address              String?
  phone                String?
  position             String?   @db.VarChar(100) // ตำแหน่งในสมาคม
  associationJoinDate DateTime? // วันที่เป็นสมาชิกสมาคม
  notes                String?   @db.Text
  cremationMember      Member?   // สมาชิกฌาปนกิจ (ถ้ามี — ทุกคนในฌาปนกิจต้องเป็นสมาชิกสมาคม)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// สมาชิกฌาปนกิจ — อ้างอิงจากสมาชิกสมาคม (ทุกคนในตารางนี้ต้องเป็นสมาชิกสมาคม)
model Member {
  id                  String            @id @default(cuid())
  associationMember  AssociationMember @relation(fields: [associationMemberId], references: [id], onDelete: Cascade)
  associationMemberId String           @unique
  memberNo           String            // เลขสมาชิกฌาปนกิจ (running number)
  school             School            @relation(fields: [schoolId], references: [id])
  schoolId           String
  group              Group?            @relation(fields: [groupId], references: [id])
  groupId            String?
  user                User?
  joinDate           DateTime          // วันที่เข้าร่วมฌาปนกิจ
  resignDate         DateTime?
  deathDate          DateTime?
  status             MemberStatus      @default(ACTIVE)
  membershipClass    MembershipClass   @default(CONTRIBUTORY)
  applicationSubmittedAt DateTime?
  applicationDeadline  DateTime?
  membershipEndReason  MembershipEndReason?
  arrearsNoticeSentAt  DateTime?
  consecutiveArrearsPeriods Int        @default(0)
  salaryDeduction    Boolean           @default(false) // หักผ่านเงินเดือนจากสำนักงานเขตพื้นที่
  beneficiaries      Beneficiary[]
  protectedPersons   ProtectedPerson[]
  contributions      MemberContribution[]
  deathClaims        DeathClaim[]      @relation("ClaimSubjectMember")
  leadedGroups       Group[]           @relation("GroupLeader")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Beneficiary {
  id          String   @id @default(cuid())
  member      Member   @relation(fields: [memberId], references: [id])
  memberId    String
  fullName    String
  relationship String
  nationalId  String?
  houseNo     String?
  moo         String?
  road        String?
  soi         String?
  subdistrict String?
  district    String?
  province    String?
  zip         String?
  phone       String?
  contactPerson String?
  contactPhone String?
  priority    Int      // 1,2,3
}

// ผู้ได้รับการคุ้มครองตามระเบียบ ข้อ 14 (คู่สมรส, บิดา-มารดา, บุตร-ธิดา)
model ProtectedPerson {
  id           String                @id @default(cuid())
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     String
  fullName     String
  relationship ProtectedRelationship
  nationalId   String?
  phone        String?
  isActive     Boolean               @default(true)
  endedAt      DateTime?
  endReason    String?
  deathClaims  DeathClaim[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ContributionPeriod {
  id           String   @id @default(cuid())
  year         Int
  month        Int      // 1–12
  welfareRate  Decimal  @db.Decimal(10,2) // ต่อสมาชิกหนึ่งคน
  serviceFee   Decimal  @db.Decimal(10,2) // ค่าบริการต่อสมาชิก
  isClosed     Boolean  @default(false)
  contributions MemberContribution[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, month])
}

model MemberContribution {
  id             String            @id @default(cuid())
  member         Member            @relation(fields: [memberId], references: [id])
  memberId       String
  period         ContributionPeriod @relation(fields: [periodId], references: [id])
  periodId       String
  school         School            @relation(fields: [schoolId], references: [id])
  schoolId       String
  welfareAmount  Decimal           @db.Decimal(10,2)
  serviceAmount  Decimal           @db.Decimal(10,2)
  totalAmount    Decimal           @db.Decimal(10,2)
  paidAmount     Decimal           @db.Decimal(10,2) @default(0)
  paidDate       DateTime?
  receipt        Receipt?          @relation(fields: [receiptId], references: [id])
  receiptId      String?           @unique
  isArrears            Boolean           @default(false)
  arrearsNoticeSentAt  DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([memberId, periodId])
}

model DeathClaim {
  id                 String          @id @default(cuid())
  member             Member          @relation("ClaimSubjectMember", fields: [memberId], references: [id])
  memberId           String
  school             School          @relation(fields: [schoolId], references: [id])
  schoolId           String
  claimNo            String          @unique
  claimType          DeathClaimType  @default(MEMBER_DEATH)
  deceasedType       DeceasedType    @default(MEMBER)
  deceasedName       String?
  relationshipNote   String?
  protectedPerson    ProtectedPerson? @relation(fields: [protectedPersonId], references: [id], onDelete: SetNull)
  protectedPersonId  String?
  reportedDate       DateTime
  deathDate          DateTime
  causeOfDeath       String?
  mainBeneficiary    String
  beneficiaryPhone   String?
  // snapshot ตามระเบียบ ข้อ 13–16 (welfareRate=อัตราเก็บ, totalContribution=ยอดรวมเก็บ, associationSupport=เข้ากองทุน 10%)
  activeMemberCount  Int
  welfareRate        Decimal         @db.Decimal(10,2)
  totalContribution  Decimal         @db.Decimal(12,2)
  associationSupport Decimal         @db.Decimal(12,2)
  payoutRatio        Decimal         @default(0.9) @db.Decimal(5,4)
  otherDeductions    Decimal         @db.Decimal(12,2)
  netToPay           Decimal         @db.Decimal(12,2)
  // Phase D — workflow เก็บเงิน + เอกสาร (ข้อ 13.3, 17, 18)
  status                 DeathClaimStatus       @default(REPORTED)
  collectionChannel      DeathCollectionChannel
  notifyAuthorityDeadline DateTime?
  collectionDeadline     DateTime
  documentDeadline       DateTime
  paymentDeadline        DateTime
  collectedAmount        Decimal                @db.Decimal(12,2) @default(0)
  collectionCompletedAt  DateTime?
  documentsComplete      Boolean                @default(false)
  documentChecklist      Json
  workflowNotes          String?                @db.Text
  // Phase E — อนุมัติเบิกเงิน (ข้อ 13.6)
  approvedBy             User?                  @relation("DeathClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById           String?
  approvedAt             DateTime?
  approverName           String?
  approverSignature      String?                @db.Text
  payment            DeathBenefitPayment?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DeathBenefitPayment {
  id            String      @id @default(cuid())
  deathClaim    DeathClaim  @relation(fields: [deathClaimId], references: [id])
  deathClaimId  String      @unique
  payDate       DateTime
  method        String      // cash / bank transfer
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  amount        Decimal     @db.Decimal(12,2)
  voucher       PaymentVoucher? @relation(fields: [voucherId], references: [id])
  voucherId     String?     @unique
}

// บัญชีธนาคารกลางของกองทุน (ไม่แยกตามโรงเรียน)
model BankAccount {
  id            String            @id @default(cuid())
  bankName      String
  accountNo     String            @unique
  accountName   String
  description   String?           // คำอธิบายบัญชี เช่น "บัญชีหลัก" "บัญชีสำรอง"
  isActive      Boolean           @default(true)
  isDefault     Boolean           @default(false) // บัญชีหลักที่ใช้รับ-จ่ายเป็นประจำ
  receipts      Receipt[]
  payments      PaymentVoucher[]
  deathBenefits DeathBenefitPayment[]
  transactions  BankTransaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BankTransaction {
  id            String              @id @default(cuid())
  transactionNo String              @unique
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  date          DateTime
  type          BankTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([bankAccountId, date])
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  entries   LedgerEntry[]
}

model LedgerEntry {
  id          String       @id @default(cuid())
  account     Account      @relation(fields: [accountId], references: [id])
  accountId   String
  date        DateTime
  description String
  debit       Decimal      @db.Decimal(12,2) @default(0)
  credit      Decimal      @db.Decimal(12,2) @default(0)
  receipt     Receipt?     @relation(fields: [receiptId], references: [id])
  receiptId   String?
  payment     PaymentVoucher? @relation(fields: [paymentId], references: [id])
  paymentId   String?
}

// ใบเสร็จรับเงิน - schoolId optional (ระบุได้ถ้าเป็นเงินจากโรงเรียนใดโรงเรียนหนึ่ง)
model Receipt {
  id            String           @id @default(cuid())
  receiptNo     String           @unique
  school        School?          @relation(fields: [schoolId], references: [id])
  schoolId      String?          // optional - ระบุโรงเรียนที่ส่งเงินมา (ถ้ามี)
  date          DateTime
  type          ReceiptType
  description   String?
  amount        Decimal          @db.Decimal(12,2)
  bankAccount   BankAccount?     @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  memberContribution MemberContribution?
  ledgerEntries LedgerEntry[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ใบสำคัญจ่าย - schoolId optional (ระบุได้ถ้าจ่ายให้โรงเรียนใดโรงเรียนหนึ่ง)
model PaymentVoucher {
  id            String       @id @default(cuid())
  voucherNo     String       @unique
  school        School?      @relation(fields: [schoolId], references: [id])
  schoolId      String?      // optional - ระบุโรงเรียนที่เกี่ยวข้อง (ถ้ามี)
  date          DateTime
  type          PaymentType
  description   String?
  amount        Decimal      @db.Decimal(12,2)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  ledgerEntries LedgerEntry[]
  deathBenefit  DeathBenefitPayment?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
