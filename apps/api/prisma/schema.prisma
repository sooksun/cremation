// prisma/schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  ADMIN
  SCHOOL_ADMIN
  FINANCE
  ACCOUNTING
  GROUP_LEADER
  VIEWER
  MEMBER
}

enum AuditAction {
  // Authentication
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_CHANGE

  // User & Role Management (sensitive: permission changes)
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ROLE_CHANGE

  // Core Business Actions
  CONTRIBUTION_PAYMENT
  BATCH_PAYMENT
  RECEIPT_CREATE
  PAYMENT_VOUCHER_CREATE

  // Death Claims
  DEATH_CLAIM_CREATE
  DEATH_CLAIM_UPDATE
  DEATH_CLAIM_APPROVE
  DEATH_CLAIM_PAYMENT

  // Member related (PII sensitive)
  MEMBER_CREATE
  MEMBER_UPDATE
  MEMBER_STATUS_CHANGE
  MEMBER_APPLICATION_APPROVE
  MEMBER_APPLICATION_REJECT

  // Period & Sensitive
  CONTRIBUTION_PERIOD_CLOSE
  ASSET_DEPRECIATION_RECORD

  // Master Data sensitive (affect permissions & finance)
  ACCOUNT_CREATE
  ACCOUNT_UPDATE
  SCHOOL_CREATE
  SCHOOL_UPDATE
  SCHOOL_DELETE
  SCHOOL_ADMIN_CREATE
  SCHOOL_ADMIN_UPDATE
  SCHOOL_ADMIN_DELETE
  GROUP_CREATE
  GROUP_UPDATE
  GROUP_DELETE
  MEMBER_TYPE_CREATE
  MEMBER_TYPE_UPDATE
  MEMBER_TYPE_DELETE
  BANK_ACCOUNT_CREATE
  BANK_ACCOUNT_UPDATE
  BANK_ACCOUNT_DELETE

  // Association & PII
  ASSOCIATION_MEMBER_CREATE
  ASSOCIATION_MEMBER_UPDATE

  // Sensitive report generation (PII / financial disclosure)
  REPORT_GENERATE

  // Settings (rate affects all money calculations)
  WELFARE_SETTINGS_UPDATE

  // Assets full lifecycle
  ASSET_CREATE
  ASSET_UPDATE
  ASSET_DISPOSE
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum MemberStatus {
  ACTIVE
  RESIGNED
  DECEASED
  ARREARS
  SUSPENDED
}

enum DeathClaimType {
  MEMBER_DEATH
  PROTECTED_DEATH
}

enum DeceasedType {
  MEMBER
  PARENT
  CHILD
  SPOUSE
}

enum DeathClaimStatus {
  REPORTED
  COLLECTING
  FUND_COMPLETE
  READY_TO_PAY
  PAID
}

enum DeathCollectionChannel {
  SALARY_DEDUCTION
  BANK_TRANSFER
}

enum MembershipClass {
  ORDINARY
  CONTRIBUTORY
}

enum ProtectedRelationship {
  SPOUSE
  PARENT
  CHILD
}

enum MembershipEndReason {
  DECEASED
  RETIRED
  RESIGNED
  ARREARS_TERMINATED
  MANUAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReceiptType {
  MEMBER_CONTRIBUTION
  MEMBERSHIP_FEE
  BOOK_FEE
  ANNUAL_FEE
  ADVANCE_WELFARE
  DEATH_COLLECTION
  OTHER
}

enum PaymentType {
  DEATH_BENEFIT
  OPERATING_EXPENSE
  BANK_FEE
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model User {
  id                  String       @id @default(cuid())
  username            String       @unique
  passwordHash        String
  role                Role
  fullName            String
  signature           String?      @db.Text // ลายเซ็นอิเล็กทรอนิกส์ (base64 image)
  mustChangePassword  Boolean      @default(false)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  school              School?      @relation(fields: [schoolId], references: [id])
  schoolId            String?
  group               Group?       @relation(fields: [groupId], references: [id])
  groupId             String?
  member              Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId            String?      @unique
  auditLogs           AuditLog[]
  approvedDeathClaims DeathClaim[] @relation("DeathClaimApprover")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  schoolId   String?
  school     School?     @relation(fields: [schoolId], references: [id])
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([schoolId])
  @@index([createdAt])
}

// กลุ่มโรงเรียน (ระดับบน) — โรงเรียนอยู่ในกลุ่ม, สมาชิกอยู่ในโรงเรียน
model SchoolCluster {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  schools   School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  district           String?
  province           String?
  isActive           Boolean              @default(true)
  cluster            SchoolCluster?       @relation(fields: [clusterId], references: [id])
  clusterId          String?
  members            Member[]
  associationMembers AssociationMember[]
  groups             Group[]
  users              User[]
  contributions      MemberContribution[]
  deathClaims        DeathClaim[]
  receipts           Receipt[]
  payments           PaymentVoucher[]
  auditLogs          AuditLog[]
  assets             Asset[]
  cashBooks          CashBook[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model MemberType {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String?
  active             Boolean             @default(true)
  associationMembers AssociationMember[]
}

model Group {
  id       String   @id @default(cuid())
  school   School   @relation(fields: [schoolId], references: [id])
  schoolId String
  code     String
  name     String
  leader   Member?  @relation("GroupLeader", fields: [leaderId], references: [id])
  leaderId String?
  members  Member[]
  users    User[]
}

// สมาชิกสมาคมผู้ประกอบวิชาชีพ (ต้นทางของข้อมูลบุคคล) — บางคนเป็นสมาชิกฌาปนกิจ บางคนไม่เป็น
model AssociationMember {
  id                    String     @id @default(cuid())
  school                School     @relation(fields: [schoolId], references: [id])
  schoolId              String
  memberType            MemberType @relation(fields: [memberTypeId], references: [id])
  memberTypeId          String
  associationMemberNo   String? // เลขสมาชิกสมาคม
  firstName             String
  lastName              String
  idCardNo              String?
  birthDate             DateTime?
  address               String? // derived (สรุปที่อยู่ติดต่อเป็น string — เพื่อ backward-compat การพิมพ์/แสดงผล)
  phone                 String?
  // ที่อยู่ทะเบียนราษฎร (structured — ระเบียบ ใบสมัคร ข้อ 3)
  registeredHouseNo     String?
  registeredMoo         String?
  registeredRoad        String?
  registeredSoi         String?
  registeredSubdistrict String?
  registeredDistrict    String?
  registeredProvince    String?
  registeredZip         String?
  // ที่อยู่ที่ติดต่อได้ (structured)
  contactHouseNo        String?
  contactMoo            String?
  contactRoad           String?
  contactSoi            String?
  contactSubdistrict    String?
  contactDistrict       String?
  contactProvince       String?
  contactZip            String?
  position              String?    @db.VarChar(100) // ตำแหน่งในสมาคม
  associationJoinDate   DateTime? // วันที่เป็นสมาชิกสมาคม
  notes                 String?    @db.Text
  cremationMember       Member? // สมาชิกฌาปนกิจ (ถ้ามี — ทุกคนในฌาปนกิจต้องเป็นสมาชิกสมาคม)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

// สมาชิกฌาปนกิจ — อ้างอิงจากสมาชิกสมาคม (ทุกคนในตารางนี้ต้องเป็นสมาชิกสมาคม)
model Member {
  id                        String               @id @default(cuid())
  associationMember         AssociationMember    @relation(fields: [associationMemberId], references: [id], onDelete: Cascade)
  associationMemberId       String               @unique
  memberNo                  String // เลขสมาชิกฌาปนกิจ (running number)
  school                    School               @relation(fields: [schoolId], references: [id])
  schoolId                  String
  group                     Group?               @relation(fields: [groupId], references: [id])
  groupId                   String?
  user                      User?
  joinDate                  DateTime // วันที่เข้าร่วมฌาปนกิจ
  resignDate                DateTime?
  deathDate                 DateTime?
  status                    MemberStatus         @default(ACTIVE)
  membershipClass           MembershipClass      @default(CONTRIBUTORY)
  applicationSubmittedAt    DateTime?
  applicationDeadline       DateTime?
  membershipEndReason       MembershipEndReason?
  arrearsNoticeSentAt       DateTime?
  consecutiveArrearsPeriods Int                  @default(0)
  salaryDeduction           Boolean              @default(false) // หักผ่านเงินเดือนจากสำนักงานเขตพื้นที่
  // การอนุมัติใบสมัคร (ระเบียบ ข้อ 15) — approvedById/approverName เก็บแบบ denormalized เพื่อ audit
  applicationStatus         ApplicationStatus?
  approvedById              String?
  approvedAt                DateTime?
  approverName              String?
  directorCertifiedName     String? // คำรับรอง ผอ.
  directorCertifiedAt       DateTime?
  committeeCertifiedName    String? // กรรมการรับสมัคร
  committeeCertifiedAt      DateTime?
  rejectedById              String?
  rejectedAt                DateTime?
  rejectReason              String?
  beneficiaries             Beneficiary[]
  protectedPersons          ProtectedPerson[]
  contributions             MemberContribution[]
  deathClaims               DeathClaim[]         @relation("ClaimSubjectMember")
  leadedGroups              Group[]              @relation("GroupLeader")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

model Beneficiary {
  id            String  @id @default(cuid())
  member        Member  @relation(fields: [memberId], references: [id])
  memberId      String
  fullName      String
  relationship  String
  nationalId    String?
  houseNo       String?
  moo           String?
  road          String?
  soi           String?
  subdistrict   String?
  district      String?
  province      String?
  zip           String?
  phone         String?
  contactPerson String?
  contactPhone  String?
  priority      Int // 1,2,3 (ระเบียบ ข้อ 19 — ลำดับผู้รับเงิน)

  @@unique([memberId, priority])
}

// ผู้ได้รับการคุ้มครองตามระเบียบ ข้อ 14 (คู่สมรส, บิดา-มารดา, บุตร-ธิดา)
model ProtectedPerson {
  id           String                @id @default(cuid())
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     String
  fullName     String
  relationship ProtectedRelationship
  nationalId   String?
  phone        String?
  isActive     Boolean               @default(true)
  endedAt      DateTime?
  endReason    String?
  deathClaims  DeathClaim[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ContributionPeriod {
  id            String               @id @default(cuid())
  year          Int
  month         Int // 1–12
  welfareRate   Decimal              @db.Decimal(10, 2) // ต่อสมาชิกหนึ่งคน
  serviceFee    Decimal              @db.Decimal(10, 2) // ค่าบริการต่อสมาชิก
  isClosed      Boolean              @default(false)
  contributions MemberContribution[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([year, month])
}

model MemberContribution {
  id                  String             @id @default(cuid())
  member              Member             @relation(fields: [memberId], references: [id])
  memberId            String
  period              ContributionPeriod @relation(fields: [periodId], references: [id])
  periodId            String
  school              School             @relation(fields: [schoolId], references: [id])
  schoolId            String
  welfareAmount       Decimal            @db.Decimal(10, 2)
  serviceAmount       Decimal            @db.Decimal(10, 2)
  totalAmount         Decimal            @db.Decimal(10, 2)
  paidAmount          Decimal            @default(0) @db.Decimal(10, 2)
  paidDate            DateTime?
  receipt             Receipt?           @relation(fields: [receiptId], references: [id])
  receiptId           String?            @unique
  isArrears           Boolean            @default(false)
  arrearsNoticeSentAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([memberId, periodId])
}

model DeathClaim {
  id                      String                 @id @default(cuid())
  member                  Member                 @relation("ClaimSubjectMember", fields: [memberId], references: [id])
  memberId                String
  school                  School                 @relation(fields: [schoolId], references: [id])
  schoolId                String
  claimNo                 String                 @unique
  claimType               DeathClaimType         @default(MEMBER_DEATH)
  deceasedType            DeceasedType           @default(MEMBER)
  deceasedName            String?
  relationshipNote        String?
  protectedPerson         ProtectedPerson?       @relation(fields: [protectedPersonId], references: [id], onDelete: SetNull)
  protectedPersonId       String?
  reportedDate            DateTime
  deathDate               DateTime
  causeOfDeath            String?
  mainBeneficiary         String
  beneficiaryPhone        String?
  // snapshot ตามระเบียบ ข้อ 13–16 (welfareRate=อัตราเก็บ, totalContribution=ยอดรวมเก็บ, associationSupport=เข้ากองทุน 10%)
  activeMemberCount       Int
  welfareRate             Decimal                @db.Decimal(10, 2)
  totalContribution       Decimal                @db.Decimal(12, 2)
  associationSupport      Decimal                @db.Decimal(12, 2)
  payoutRatio             Decimal                @default(0.9) @db.Decimal(5, 4)
  otherDeductions         Decimal                @db.Decimal(12, 2)
  netToPay                Decimal                @db.Decimal(12, 2)
  // Fixed benefit support (ตามมติคณะกรรมการ)
  isFixedBenefit          Boolean                @default(false)
  fixedBenefitAmount      Decimal?               @db.Decimal(12, 2)
  // Phase D — workflow เก็บเงิน + เอกสาร (ข้อ 13.3, 17, 18)
  status                  DeathClaimStatus       @default(REPORTED)
  collectionChannel       DeathCollectionChannel
  notifyAuthorityDeadline DateTime?
  collectionDeadline      DateTime
  documentDeadline        DateTime
  paymentDeadline         DateTime
  collectedAmount         Decimal                @default(0) @db.Decimal(12, 2)
  collectionCompletedAt   DateTime?
  documentsComplete       Boolean                @default(false)
  documentChecklist       Json
  workflowNotes           String?                @db.Text
  // Phase E — อนุมัติเบิกเงิน (ข้อ 13.6)
  approvedBy              User?                  @relation("DeathClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById            String?
  approvedAt              DateTime?
  approverName            String?
  approverSignature       String?                @db.Text
  payment                 DeathBenefitPayment?
  // เอกสารบัญชีที่ผูกตอนจ่ายจริง (ข้อ 13/16 — เก็บ gross ขาเข้า + จ่าย net ขาออก + กองทุน 10%)
  collectionReceipt       Receipt?               @relation("ClaimCollectionReceipt", fields: [collectionReceiptId], references: [id])
  collectionReceiptId     String?                @unique
  benefitVoucher          PaymentVoucher?        @relation("ClaimBenefitVoucher", fields: [benefitVoucherId], references: [id])
  benefitVoucherId        String?                @unique
  // ข้อ 18 — การสงเคราะห์ (18.1 พวงหรีด, 18.2 ร่วมเป็นเจ้าภาพสวดอภิธรรม)
  condolenceWreathAt      DateTime?
  funeralPrayerAt         DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model DeathBenefitPayment {
  id            String          @id @default(cuid())
  deathClaim    DeathClaim      @relation(fields: [deathClaimId], references: [id])
  deathClaimId  String          @unique
  payDate       DateTime
  method        String // cash / bank transfer
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  amount        Decimal         @db.Decimal(12, 2)
  voucher       PaymentVoucher? @relation(fields: [voucherId], references: [id])
  voucherId     String?         @unique
}

// บัญชีธนาคารกลางของกองทุน (ไม่แยกตามโรงเรียน)
model BankAccount {
  id            String                @id @default(cuid())
  bankName      String
  accountNo     String                @unique
  accountName   String
  description   String? // คำอธิบายบัญชี เช่น "บัญชีหลัก" "บัญชีสำรอง"
  isActive      Boolean               @default(true)
  isDefault     Boolean               @default(false) // บัญชีหลักที่ใช้รับ-จ่ายเป็นประจำ
  receipts      Receipt[]
  payments      PaymentVoucher[]
  deathBenefits DeathBenefitPayment[]
  transactions  BankTransaction[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model BankTransaction {
  id            String              @id @default(cuid())
  transactionNo String              @unique
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  date          DateTime
  type          BankTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime? // soft-delete (retention 10 ปี ตามข้อบังคับสมาคม ข้อ 30)

  @@index([bankAccountId, date])
}

model Account {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  type     AccountType
  isActive Boolean       @default(true)
  entries  LedgerEntry[]
}

model LedgerEntry {
  id          String          @id @default(cuid())
  account     Account         @relation(fields: [accountId], references: [id])
  accountId   String
  date        DateTime
  description String
  debit       Decimal         @default(0) @db.Decimal(12, 2)
  credit      Decimal         @default(0) @db.Decimal(12, 2)
  receipt     Receipt?        @relation(fields: [receiptId], references: [id])
  receiptId   String?
  payment     PaymentVoucher? @relation(fields: [paymentId], references: [id])
  paymentId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
}

// ใบเสร็จรับเงิน - schoolId optional (ระบุได้ถ้าเป็นเงินจากโรงเรียนใดโรงเรียนหนึ่ง)
model Receipt {
  id                   String              @id @default(cuid())
  receiptNo            String              @unique
  school               School?             @relation(fields: [schoolId], references: [id])
  schoolId             String? // optional - ระบุโรงเรียนที่ส่งเงินมา (ถ้ามี)
  date                 DateTime
  type                 ReceiptType
  description          String?
  amount               Decimal             @db.Decimal(12, 2)
  bankAccount          BankAccount?        @relation(fields: [bankAccountId], references: [id])
  bankAccountId        String?
  memberContribution   MemberContribution?
  ledgerEntries        LedgerEntry[]
  deathClaimCollection DeathClaim?         @relation("ClaimCollectionReceipt")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

// ใบสำคัญจ่าย - schoolId optional (ระบุได้ถ้าจ่ายให้โรงเรียนใดโรงเรียนหนึ่ง)
model PaymentVoucher {
  id                String               @id @default(cuid())
  voucherNo         String               @unique
  school            School?              @relation(fields: [schoolId], references: [id])
  schoolId          String? // optional - ระบุโรงเรียนที่เกี่ยวข้อง (ถ้ามี)
  date              DateTime
  type              PaymentType
  description       String?
  amount            Decimal              @db.Decimal(12, 2)
  bankAccount       BankAccount?         @relation(fields: [bankAccountId], references: [id])
  bankAccountId     String?
  ledgerEntries     LedgerEntry[]
  deathBenefit      DeathBenefitPayment?
  deathClaimBenefit DeathClaim?          @relation("ClaimBenefitVoucher")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ตั้งค่าอัตราเงินช่วยเหลือ (ตามมติคณะกรรมการ) - สำหรับเงินสงเคราะห์ศพแบบคงที่
model WelfareSettings {
  id                   String   @id @default(cuid())
  effectiveDate        DateTime // วันที่มีผลบังคับใช้
  welfareAmountPerCase Decimal  @db.Decimal(12, 2) // อัตราเงินช่วยเหลือต่อราย (เต็มจำนวน)
  description          String? // หมายเหตุ เช่น "ตามมติที่ประชุม ครั้งที่ 1/2567"
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// สินทรัพย์ถาวร (Fixed Assets) - Optional แต่ควรมีสำหรับ future
model Asset {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  code             String?
  name             String
  description      String?
  category         String? // e.g. เครื่องมือ, ยานพาหนะ, อาคาร
  purchaseDate     DateTime
  originalCost     Decimal   @db.Decimal(12, 2)
  salvageValue     Decimal   @default(0) @db.Decimal(12, 2)
  usefulLifeYears  Int
  accumulatedDep   Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("ACTIVE") // ACTIVE, DISPOSED
  disposalDate     DateTime?
  disposalProceeds Decimal?  @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CashBook {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  date        DateTime
  type        String // IN, OUT
  amount      Decimal   @db.Decimal(12, 2)
  description String?
  receiptId   String?   @unique
  paymentId   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete (retention 10 ปี ตามข้อบังคับสมาคม ข้อ 30)

  @@index([schoolId, date])
}
