# Copy to .env.production on the deploy server (gitignored)
# Use with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# หรือใช้สคริปต์: bash deploy/install.sh (ครั้งแรก) / bash deploy/update.sh (อัปเดต)

# --- Database: external MariaDB on host (host.docker.internal:3306) ---
# user เฉพาะ cremation_app (สร้างด้วย deploy/mariadb-setup.sql) — อย่าใช้ root
# แทน CHANGE_ME ด้วยรหัสจริงบน server เท่านั้น (ห้าม commit)
DATABASE_URL=mysql://cremation_app:CHANGE_ME@host.docker.internal:3306/cremation_db

# --- Auth ---
# สร้างด้วย: openssl rand -base64 48  (ต้องยาว >= 32 ตัวอักษร)
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET
JWT_EXPIRES_IN=7d

# --- URLs (เข้าตรงด้วย LAN IP, ไม่มี TLS/NPM) ---
# web origin -> ใช้เป็น CORS_ORIGINS + FRONTEND_URL ของ api
WEB_ORIGIN=http://192.168.1.4:9950

# api base URL ที่ browser เรียกตรง -> bake เข้า web image ตอน build
# (ถ้าเปลี่ยน IP/port ต้อง rebuild web: docker compose build web)
NEXT_PUBLIC_API_URL=http://192.168.1.4:9951/api

# --- Backup ---
BACKUP_RETAIN_DAYS=14
