# Copy to .env.production on deploy server (gitignored)
# Use with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# External MariaDB on host (CasaOS mariadb container)
DATABASE_URL=mysql://root:CHANGE_ME@host.docker.internal:3306/cremation_db

# Auth (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET
JWT_EXPIRES_IN=7d

# Public site URL (NPM TLS terminate)
WEB_ORIGIN=https://cremation.example.com

# Leave empty when NPM proxies /api/ to api:9931 (same-origin)
NEXT_PUBLIC_API_URL=

# Backup retention
BACKUP_RETAIN_DAYS=14