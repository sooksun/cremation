# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS builder
WORKDIR /repo

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cremation/api exec prisma generate
RUN pnpm --filter @cremation/api run build
RUN pnpm deploy --filter @cremation/api --prod /out \
  && mkdir -p /out/prisma \
  && cp -r /repo/apps/api/prisma/. /out/prisma/ \
  && cd /out && npx --yes prisma@5.22.0 generate --schema=./prisma/schema.prisma

FROM node:20-bookworm-slim AS runner
WORKDIR /app

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssl ca-certificates tzdata \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV API_PORT=4000

COPY --from=builder /out ./

EXPOSE 4000

CMD ["sh", "-c", "npx --yes prisma@5.22.0 migrate deploy --schema=./prisma/schema.prisma && node dist/main.js"]