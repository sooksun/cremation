# Off-host backup: config, passphrase, encrypted staging, and anything restored.
# The passphrase is the only thing standing between a leaked dump and 604 national IDs.
.env.offsite
.backup-passphrase
backup/.encrypted/
backup/restored/
backup/*.gpg

# === Generated / test data (NEVER commit) ===
# Large data exports accidentally placed in public/ (public is served without auth)
apps/web/public/evaluations*.sql
apps/web/public/generated_video.mp4

# DB dumps and source PII spreadsheets (real national ID / phone / password hashes)
prisma/*.sql
doc/member/

# Test artifacts, temporary logs, dev outputs
apps/web/test-output/
terminals/
output/

# MCP server tool definitions (loaded dynamically per session)
mcps/


# build artifacts / install bundles
/dist/

